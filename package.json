{
  "name": "@martian-engineering/lossless-claw",
  "version": "1.2.0",
  "description": "Lossless Context Management plugin for OpenClaw — DAG-based conversation summarization with threshold compaction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lcm": "dist/cli.js",
    "lossless-claw-migrate-sessions": "dist/migrate-sessions.js"
  },
  "license": "MIT",
  "author": "Josh Lehman <josh@martian.engineering>",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:search-worker && npm run build:doctor-cleaner-worker && npm run build:db-backup-worker && npm run build:migrate-sessions && npm run build:cli && npm run build:ui",
    "build:plugin": "esbuild index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace",
    "build:search-worker": "esbuild src/search/search-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/search-worker.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace",
    "build:doctor-cleaner-worker": "esbuild src/plugin/doctor-cleaner-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/doctor-cleaner-worker.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace",
    "build:db-backup-worker": "esbuild src/plugin/db-backup-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/db-backup-worker.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace",
    "build:migrate-sessions": "esbuild src/cli/migrate-sessions.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/migrate-sessions.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace",
    "build:cli": "esbuild cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.js --minify-whitespace",
    "changeset": "changeset",
    "plugin-inspector:ci": "npm exec --yes --package @openclaw/plugin-inspector@0.3.11 -- plugin-inspector ci --plugin-root . --out plugin-inspector-reports",
    "release:verify": "npm run typecheck && npm run build && npm test && npm run test:tui && npm pack --dry-run",
    "test": "vitest run --dir test",
    "test:tui": "cd tui && go test ./...",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.ui.json",
    "version-packages": "changeset version",
    "build:ui": "esbuild ui/control-ui.ts --bundle --platform=browser --target=es2022 --format=esm --outfile=dist/control-ui/index.js --minify"
  },
  "files": [
    "dist/",
    "doctor-contract-api.d.ts",
    "doctor-contract-api.js",
    "skills/",
    "openclaw.plugin.json",
    "docs/",
    "!docs/superpowers/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "date-fns": "^4.4.0",
    "dayjs": "^1.10.8",
    "escape-string-regexp": "^5.0.0",
    "nanoid": "^3.3.4",
    "openai": "^7.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.5.0",
    "esbuild": "^0.28.2",
    "marked": "^18.3.0",
    "openclaw": "2026.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2",
      "minGatewayVersion": "2026.9.2",
      "tested": [
        "2026.9.4",
        "2026.9.5"
      ]
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martian-Engineering/lossless-claw.git"
  },
  "homepage": "https://github.com/Martian-Engineering/lossless-claw#readme",
  "bugs": {
    "url": "https://github.com/Martian-Engineering/lossless-claw/issues"
  }
}
